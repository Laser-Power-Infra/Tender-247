// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- FILES ----------
model File {
  id        Int      @id @default(autoincrement())
  fileName  String
  filePath  String?
  fileType  String?
  fileSize  Int?
  uploadedBy String?
  status    String?

  totalCount Int? @default(0)
  excludedCount Int? @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gemTenders    GemTender[]
  nonGemTenders NonGemTender[]

  @@map("files")
}

// ---------- GEM TENDER ----------
model GemTender {
  id Int @id @default(autoincrement())

  fileId Int
  file   File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  referenceNo String @unique
  tenderBrief String?

  value String?
  deadline DateTime?
  location String?
  organization String?
  documentFees String?
  emd String?
  msmeExemption String?
  startupExemption String?
  quantity String?
  bidOpeningDateTime String?
  bidOfferValidity String?

  ministryStateName String?
  departmentName String?
  officeName String?

  minimumAverageAnnualTurnover String?
  yearsOfPastExperience String?
  oemAverageTurnover String?
  contractPeriod String?

  financialDocumentPriceBreakupRequired String?
  similarCategory String?
  pastExperienceSimilarServicesRequired String?

  documentRequiredFromSeller String?
  pastPerformance String?
  bidToRaEnabled String?
  raQualificationRule String?

  boqTitle String?
  bidDetails String?

  comprehensiveMaintenanceChargesRequired String?
  typeOfBid String?

  technicalClarificationTimeAllowed String?
  inspectionRequired String?

  estimatedBidValue String?
  evaluationMethod String?
  advisoryBank String?

  ePbgPercentage String?
  ePbgDurationMonths String?

  msePurchasePreference String?
  miiPurchasePreference String?

  consigneesReportingOfficer String?
  mediationClause String?
  arbitrationClause String?

  checklist String?

  t247Id String?
  scrapedDate String?
  source String?
  assignedTo String?
  markedStatus String?
  sheetStatus String?
  ready String?
  searchKey String?
  downloadLink String?
  currency String?

  excludedCategory String?

  aiRelevanceValid   Boolean?
  aiRelevanceReason  String?

  tenderFileUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  extraFields TenderExtraField[]

  @@index([fileId])
  @@map("gem_tenders")
}

// ---------- NON GEM ----------
model NonGemTender {
  id Int @id @default(autoincrement())

  fileId Int
  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  referenceNo String @unique
  tenderBrief String?

  estimatedBidValue String?
  deadline DateTime?
  location String?
  organization String?

  documentFees String?
  emd String?

  msmeExemption String?
  startupExemption String?

  quantity String?

  checklist String?

  t247Id String?
  scrapedDate String?
  source String?
  assignedTo String?
  markedStatus String?
  sheetStatus String?
  ready String?
  searchKey String?
  downloadLink String?
  currency String?

  excludedCategory String?

  aiRelevanceValid   Boolean?
  aiRelevanceReason  String?

  tenderFileUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  extraFields TenderExtraField[]

  @@index([fileId])
  @@map("non_gem_tenders")
}

model TenderExtraField {
  id Int @id @default(autoincrement())

  gemTenderId Int?
  gemTender GemTender? @relation(fields: [gemTenderId], references: [id], onDelete: Cascade)

  nonGemTenderId Int?
  nonGemTender NonGemTender? @relation(fields: [nonGemTenderId], references: [id], onDelete: Cascade)

  fieldName  String
  fieldValue String? 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gemTenderId])
  @@index([nonGemTenderId])

  @@map("tender_extra_fields")
}

model ExlusionKeywords{
  id Int @id @default(autoincrement())

  category String @unique
  keywords String? @default("cable")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


